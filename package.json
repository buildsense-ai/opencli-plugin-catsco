{
  "name": "opencli-plugin-catsco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "description": "OpenCLI plugin for CatsCo AI agent assistant (app.catsco.cc)",
  "scripts": {
    "build:plugin": "node ./scripts/build-plugin.mjs",
    "test": "vitest",
    "test:run": "vitest run",
