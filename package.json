  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@jackwener/opencli"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
